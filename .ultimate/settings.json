{
  "extensions": {
    "disable": [
      "voice"
    ]
  },
  "modelFamilies": {
    "families": {
      "default": {
        "model": "deepseek/deepseek-flash"
      },
      "lead": {
        "model": "deepseek/deepseek-flash",
        "thinking": "high",
        "color": "orange"
      },
      "fast": {
        "model": "deepseek/deepseek-flash"
      },
      "design": {
        "model": "deepseek/deepseek-flash",
        "thinking": "high"
      },
      "tiny": {
        "model": "llmhub/Qwen3.6-35B-A3B-FP8",
        "thinking": "low",
        "fallback": [
          "llmhub/NVIDIA-Nemotron-3-Super-120B-A12B-FP8",
          "llmhub/Mistral-Small-4-119B-2603",
          "llmhub/gemma-4-31B-it-FP8",
          "deepseek/deepseek-flash"
        ]
      },
      "review": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "fallback": "deepseek/deepseek-flash"
      }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": [
        "pnpm install --frozen-lockfile --prefer-offline"
      ]
    }
  },
  "lander": {
    "checks": [
      {
        "command": "pnpm check",
        "timeout": 120
      },
      {
        "command": "mkdir -p \"$HOME/.ultimate/tmp\" && TMPDIR=\"$HOME/.ultimate/tmp\" pnpm test",
        "timeout": 300
      }
    ],
    "push": "origin"
  }
}
