{
  "extensions": {
    "disable": [
      "voice"
    ]
  },
  "modelFamilies": {
    "families": {
      "default": {
        "model": "deepseek/deepseek-flash",
        "fallback": "llmhub/GLM-5.3"
      },
      "lead": {
        "model": "deepseek/deepseek-flash",
        "thinking": "high",
        "color": "orange",
        "fallback": "llmhub/GLM-5.3"
      },
      "fast": {
        "model": "deepseek/deepseek-flash",
        "fallback": "llmhub/GLM-5.3"
      },
      "design": {
        "model": "deepseek/deepseek-flash",
        "thinking": "high",
        "fallback": "llmhub/GLM-5.3"
      },
      "tiny": {
        "model": "llmhub/GLM-5.3",
        "thinking": "low",
        "fallback": "deepseek/deepseek-flash"
      },
      "review": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "fallback": "deepseek/deepseek-flash"
      }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": [
        "pnpm install --frozen-lockfile --prefer-offline"
      ]
    }
  },
  "lander": {
    "checks": [
      {
        "command": "pnpm check",
        "timeout": 120
      },
      {
        "command": "mkdir -p \"$HOME/.ultimate/tmp\" && TMPDIR=\"$HOME/.ultimate/tmp\" pnpm test",
        "timeout": 300
      }
    ],
    "push": "origin"
  }
}
